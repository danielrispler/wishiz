POSTGRES_DB=wishiz
POSTGRES_USER=wishiz
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgres://wishiz:change-this-postgres-password@postgres:5432/wishiz?sslmode=disable

MINIO_ROOT_USER=wishiz
MINIO_ROOT_PASSWORD=change-this-minio-password
STORAGE_S3_BUCKET=wishiz-images
STORAGE_PUBLIC_BASE_URL=https://storage.your-domain.example

API_BIND_ADDR=0.0.0.0
MINIO_BIND_ADDR=127.0.0.1
MINIO_CONSOLE_BIND_ADDR=127.0.0.1

RUN_DB_MIGRATIONS=true
UPLOADS_ENABLED=true
SHARE_BASE_URL=https://wishiz.app
