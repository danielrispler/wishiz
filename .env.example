# Copy to .env for local docker-compose. Values here are dev defaults.

# --- Postgres (docker-compose `postgres` service) ---
POSTGRES_DB=wishiz
POSTGRES_USER=wishiz
POSTGRES_PASSWORD=change-me

# The api container talks to the `postgres` service over the compose network.
DATABASE_URL=postgres://wishiz:change-me@postgres:5432/wishiz?sslmode=disable

# --- API ---
# Local monolith. In production the same binary is deployed as api / scraper /
# migrate / weekly-batch via SERVICE_ROLE.
SERVICE_ROLE=all
RUN_DB_MIGRATIONS=true
# Pool size per instance; keep Σ(instances × DB_MAX_CONNS) under the pooler cap.
DB_MAX_CONNS=5

# --- Uploads (GCS) ---
# Off by default; no GCS needed to run locally. To exercise uploads, run a
# fake-gcs-server, point STORAGE_EMULATOR_HOST at it, set BUCKET_NAME, enable.
UPLOADS_ENABLED=false
BUCKET_NAME=
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com
# STORAGE_EMULATOR_HOST=http://localhost:4443

# --- Scraper backstop (optional, import path only) ---
ZENROWS_API_KEY=
ZENROWS_TIMEOUT=30s

# --- Live import dispatch (api role, production only) ---
# Full Cloud Tasks queue path + scraper service URL enable directed dispatch.
# Empty locally -> the in-process poller (all role) drains imports.
# IMPORT_TASKS_QUEUE=projects/PROJECT/locations/REGION/queues/import-dispatch
# SCRAPER_URL=https://wishiz-scraper-xxxx.run.app
# SCRAPER_AUDIENCE=https://wishiz-scraper-xxxx.run.app
# SCRAPER_INVOKER_SA=cloud-tasks-invoker@PROJECT.iam.gserviceaccount.com
# IMPORT_DRAIN_LIMIT=20

# --- Misc ---
SHARE_BASE_URL=https://wishiz-api-pdst26qeja-ey.a.run.app
# INTERNAL_API_KEY=
