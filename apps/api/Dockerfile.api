# syntax=docker/dockerfile:1.7
#
# wishiz-api image: the request-driven api service and the migrate Job. Slim, no
# Chromium (it never scrapes). SERVICE_ROLE is overridden to "migrate" on the Job.
# The binary is fully static (CGO_ENABLED=0), so the final stage is distroless
# static (CA certs + zoneinfo baked in) and runs non-root by default.

FROM golang:1.25-bookworm AS builder

WORKDIR /src

ARG TARGETOS=linux
ARG TARGETARCH

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

COPY --from=builder /out/api /app/api

EXPOSE 8080

ENV SERVICE_ROLE=api

ENTRYPOINT ["/app/api"]
