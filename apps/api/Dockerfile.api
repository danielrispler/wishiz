# syntax=docker/dockerfile:1.7
#
# wishiz-api image: the request-driven api service and the migrate Job. Slim, no
# Chromium (it never scrapes). SERVICE_ROLE is overridden to "migrate" on the Job.

FROM golang:1.24-bookworm AS builder

WORKDIR /src

ARG TARGETOS=linux
ARG TARGETARCH

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/api ./cmd/api

FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/api /app/api

EXPOSE 8080

ENV SERVICE_ROLE=api

ENTRYPOINT ["/app/api"]
